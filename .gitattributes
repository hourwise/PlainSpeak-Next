# Normalise line endings so the same input text produces the same bytes on
# every platform. Cross-platform textual determinism is a project invariant,
# and CRLF drift in fixtures would silently break it.
* text=auto eol=lf

# Fixtures, goldens and corpora are byte-significant: the seal hashes their
# exact bytes, so git must never rewrite a line ending inside them.
tests/characterisation/corpus/**   -text
tests/characterisation/formats/**  -text
tests/characterisation/golden/**   -text
corpora/**                         -text

# Binary document formats.
*.docx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary

# The style calibration corpus and its snapshot are byte-significant: the
# thresholds were drawn against these exact bytes.
tests/style/corpus/**              -text
tests/style/corpus-findings.json   -text
