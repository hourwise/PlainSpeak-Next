{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "localsrv": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local OpenAI-compatible server",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "gemma-4": {
          "name": "Gemma 4 (local)"
        }
      }
    }
  },
  "model": "localsrv/gemma-4",
  "mcp": {
    "servers": {
      "plainspeak": {
        "type": "local",
        "command": [
          "plainspeak",
          "serve"
        ]
      }
    }
  }
}
